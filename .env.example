# WorthyBound environment variables.
# Copy to .env and fill in local values. Never commit .env.
# Placeholder values below are NOT secrets and must be replaced.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=worthybound
POSTGRES_USER=worthybound
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://worthybound:change-me-local-only@127.0.0.1:5432/worthybound
# Integration tests create and drop throwaway databases through this connection.
# The role needs CREATEDB. Never point it at a database with real data.
TEST_DATABASE_URL=postgresql://worthybound:change-me-local-only@127.0.0.1:5432/postgres

# --- Object storage for evidence (S3-compatible, docker-compose) ---
# Also used by the API and by tests, which create and delete throwaway `wb-test-*` buckets.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
# Private bucket for all evidence. Create it with `pnpm storage:setup`. Public photos are served
# through the API, never from a public bucket.
S3_BUCKET_EVIDENCE_PRIVATE=worthybound-evidence-private
S3_ACCESS_KEY_ID=change-me-local-only
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Public address of the API; token metadata links point here. Required in production.
API_PUBLIC_URL=
# Built web app to serve on the API's origin (`pnpm --filter @worthybound/web build`), relative to
# apps/api. Leave empty in development and run `pnpm --filter @worthybound/web dev` instead.
WEB_DIST_DIR=
# Number of reverse proxies whose X-Forwarded-For entries are trusted (1 on Render); 0 = none.
TRUST_PROXY=0
# Host (and port) of the website users sign in to. Bound into every Sign-In With Solana
# message so a signature for another site is rejected, and used for public passport links
# (QR codes). Must be a public domain in production.
AUTH_DOMAIN=localhost
# At least 32 characters, e.g. `openssl rand -base64 48`. Keys the hashes of IP addresses and
# user agents in sessions and audit logs. The API refuses to start without it.
SESSION_SECRET=
# At least 32 characters, e.g. `openssl rand -base64 48`. Keys the fingerprints that stop the
# same item being registered twice. The API refuses to start without it. Changing it means
# recomputing every stored fingerprint, so keep it stable.
SERIAL_FINGERPRINT_KEY=

# --- Solana (Devnet only, ADR 0016) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional WebSocket endpoint for confirmations; defaults to SOLANA_RPC_URL with ws(s).
SOLANA_WS_URL=
# Optional guard: if set, must be the program this build uses.
WORTHYBOUND_PROGRAM_ID=5stfBCcoD9mpW3514ycoKZBQ4Xzav3KpbZHTC9AUGMem
# Oracle keypair file stored OUTSIDE the repository (e.g. ~/.config/solana/). It signs and pays
# for registrations, status and Trust Score updates. Must not be the upgrade authority / admin.
# Without it, tokenization is unavailable.
SOLANA_TRUST_ORACLE_KEYPAIR_PATH=

# --- AI checks (ADR 0013) ---
# OpenAI API key for AI checks of owner evidence and reports on verifier applications. Owners
# opt in per asset. Without it, AI checks are unavailable.
OPENAI_API_KEY=
# Optional model override; defaults to the model in @worthybound/automated-checks.
OPENAI_MODEL=
