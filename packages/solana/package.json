{
  "name": "@worthybound/solana",
  "version": "0.1.0",
  "private": true,
  "description": "Client for the WorthyBound Solana program (Devnet only)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:client": "node scripts/generate-client.mjs"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@worthybound/shared": "workspace:*"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@types/node": "^24.19.0",
    "codama": "^1.11.0",
    "litesvm": "^1.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
