// WorthyBound data model.
// Integrity rules that Prisma cannot express (append-only tables, check constraints,
// partial unique indexes, provenance hash chain, authority checks) live in the SQL
// migrations and are documented in docs/adr/0005-database-integrity.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Role {
  USER
  VERIFIER
  VERIFIER_REVIEWER
  ADMIN
}

enum AssetCategory {
  LUXURY_WATCH
  FINE_ART
  JEWELRY
  COLLECTIBLE_CAR
  COLLECTIBLE
  EQUIPMENT
  OTHER
}

enum AssetStatus {
  DRAFT
  TOKENIZED
  ACTIVE
  VERIFIED
  TRANSFER_PENDING
  REVERIFICATION_REQUIRED
  DISPUTED
  REPORTED_LOST
  REPORTED_STOLEN
  REVOKED
}

/// Overall physical condition. Details belong in notes or a condition report.
enum ItemCondition {
  NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  POOR
  FOR_PARTS
}

enum TokenizationStatus {
  NOT_TOKENIZED
  PENDING
  TOKENIZED
  FAILED
}

enum VerificationLevel {
  UNVERIFIED
  SELF_DOCUMENTED
  INSPECTED
  AUTHENTICATED
  MULTI_VERIFIED
}

enum OwnershipReason {
  REGISTRATION
  TRANSFER
  RECOVERY
  ADMIN_CORRECTION
}

enum TransferStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ProofSource {
  OWNER
  THIRD_PARTY
  VERIFIER
  MANUFACTURER
}

enum EvidenceType {
  PHOTO
  RECEIPT
  CERTIFICATE
  PROVENANCE_DOCUMENT
  SERIAL_NUMBER
  INSPECTION_REPORT
  APPRAISAL_DOCUMENT
  CONDITION_REPORT
  SERVICE_RECORD
  OWNERSHIP_DOCUMENT
  MANUFACTURER_DOCUMENT
  VIDEO
  OTHER
}

enum EvidenceVisibility {
  PRIVATE
  PUBLIC
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VerifierStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  REVOKED
}

enum VerifierEntityType {
  INDIVIDUAL
  BUSINESS
  LABORATORY
  MANUFACTURER
}

enum CategoryPermissionStatus {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum VerificationRequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ClaimType {
  SERIAL_NUMBER
  POSSESSION
  CONDITION
  INSPECTION
  AUTHENTICATION
  APPRAISAL
  PROVENANCE
  CERTIFICATE
  PHYSICAL_EXISTENCE
  IDENTITY_OF_PRESENTER
  DOCUMENTATION
  OWNERSHIP_CLAIM
}

enum AttestationResult {
  CONFIRMED
  CONTRADICTED
  INCONCLUSIVE
}

enum AttestationMethod {
  IN_PERSON
  REMOTE
  LABORATORY
  DOCUMENT_REVIEW
}

enum AssuranceLevel {
  LOW
  MEDIUM
  HIGH
}

enum AttestationStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  DISPUTED
  REVOKED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  REJECTED
  WITHDRAWN
}

enum ProvenanceEventType {
  REGISTERED
  TOKENIZED
  EVIDENCE_ADDED
  EVIDENCE_VISIBILITY_CHANGED
  EVIDENCE_REVIEWED
  EVIDENCE_COMMITTED
  ATTESTATION_ADDED
  ATTESTATION_REVOKED
  TRANSFER_REQUESTED
  TRANSFER_COMPLETED
  STATUS_CHANGED
  CONDITION_UPDATED
  DETAILS_UPDATED
  REVERIFICATION_REQUIRED
  REPORTED_LOST
  REPORTED_STOLEN
  RECOVERED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  CAPTURE_COMPLETED
}

enum SolanaCluster {
  LOCALNET
  DEVNET
}

enum ChainTransactionKind {
  REGISTER_ASSET
  MINT_ASSET
  COMMIT_EVIDENCE
  APPROVE_VERIFIER
  UPDATE_VERIFIER
  SUBMIT_ATTESTATION
  REVOKE_ATTESTATION
  COMMIT_TRUST_SCORE
  TRANSFER_ASSET
  UPDATE_ASSET_STATUS
}

enum ChainEntityType {
  ASSET
  VERIFIER
  ATTESTATION
  EVIDENCE_COMMITMENT
  TRUST_SCORE_SNAPSHOT
  TRANSFER_REQUEST
}

enum ChainTransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FINALIZED
  FAILED
  /// Not sent: the chain already held this update or a newer one.
  SUPERSEDED
}

enum AutomatedCheckResult {
  PASSED
  FAILED
  INCONCLUSIVE
}

enum AutomatedJobKind {
  EVIDENCE_CHECK
  VERIFIER_REPORT
}

enum AutomatedJobStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VerifierReportRecommendation {
  APPROVE
  REJECT
  NEEDS_MORE_INFORMATION
}

// ─── Identity and access ──────────────────────────────────────────────────────

/// A wallet address is never treated as proof of real-world identity.
/// Only KYC status and the provider reference are stored, never identity documents.
model User {
  id                  String         @id @default(uuid(7)) @db.Uuid
  walletAddress       String         @unique
  displayName         String?
  email               String?        @unique
  identityStatus      IdentityStatus @default(UNVERIFIED)
  identityProvider    String?
  identityProviderRef String?
  identityVerifiedAt  DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  sessions                  Session[]
  roles                     RoleAssignment[]                  @relation("RoleHolder")
  rolesGranted              RoleAssignment[]                  @relation("RoleGranter")
  assets                    Asset[]
  ownerships                Ownership[]
  transfersSent             TransferRequest[]                 @relation("TransferFrom")
  transfersReceived         TransferRequest[]                 @relation("TransferTo")
  evidenceUploaded          Evidence[]                        @relation("EvidenceUploader")
  evidenceReviewed          Evidence[]                        @relation("EvidenceReviewer")
  evidenceUploads           EvidenceUpload[]
  captureSessions           CaptureSession[]
  verifier                  Verifier?                         @relation("VerifierUser")
  verifiersApproved         Verifier[]                        @relation("VerifierApprover")
  permissionsApproved       VerifierCategoryPermission[]
  verificationRequests      VerificationRequest[]
  templateVersionsCreated   VerificationTemplateVersion[]     @relation("TemplateVersionCreator")
  templateVersionsPublished VerificationTemplateVersion[]     @relation("TemplateVersionPublisher")
  disputesOpened            Dispute[]                         @relation("DisputeOpener")
  disputesResolved          Dispute[]                         @relation("DisputeResolver")
  assetStatusEvents         AssetStatusEvent[]
  verifierStatusEvents      VerifierStatusEvent[]
  permissionEvents          VerifierCategoryPermissionEvent[]
  attestationStatusEvents   AttestationStatusEvent[]
  requestStatusEvents       VerificationRequestStatusEvent[]
  provenanceEvents          ProvenanceEvent[]
  auditLogs                 AuditLog[]
  idempotencyKeys           IdempotencyKey[]
  automatedChecksConsents   Asset[]                           @relation("AutomatedChecksConsent")
  verifierReportsRequested  VerifierApplicationReport[]
  automatedJobsRequested    AutomatedJob[]

  @@map("users")
}

/// Single-use Sign-In With Solana nonce.
model AuthNonce {
  id            String    @id @default(uuid(7)) @db.Uuid
  walletAddress String
  nonce         String    @unique
  domain        String
  issuedAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)

  @@index([walletAddress])
  @@map("auth_nonces")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  /// SHA-256 of the session token; the token itself is never stored.
  tokenHash     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  ipHash        String?
  userAgentHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  role        Role
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  user      User  @relation("RoleHolder", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("role_assignments")
}

// ─── Assets ───────────────────────────────────────────────────────────────────

model Asset {
  id                          String             @id @default(uuid(7)) @db.Uuid
  /// Permanent WorthyBound identifier, e.g. WB-7F93A281.
  wbId                        String             @unique
  ownerId                     String             @db.Uuid
  category                    AssetCategory
  brand                       String?
  model                       String?
  /// Private. Never exposed in the public passport or on-chain.
  serialNumber                String?
  /// Keyed HMAC of category, brand and normalized serial. Unique among assets that are not REVOKED.
  serialFingerprint           String?
  serialFingerprintKeyVersion Int?
  description                 String?
  publicDescription           String?
  attributes                  Json               @default("{}")
  /// Owner-stated. The verified condition comes from CONDITION attestations.
  condition                   ItemCondition?
  status                      AssetStatus        @default(DRAFT)
  tokenizationStatus          TokenizationStatus @default(NOT_TOKENIZED)
  chainAssetAddress           String?            @unique
  chainRecordAddress          String?            @unique
  /// Derived from the latest TrustScoreSnapshot. Never set from user input.
  currentTrustScore           Int                @default(0)
  verificationLevel           VerificationLevel  @default(UNVERIFIED)
  /// Set once when the owner publishes the passport. Identity fields are locked from then on.
  publishedAt                 DateTime?          @db.Timestamptz(3)
  /// Who agreed to send this asset's private evidence to the AI check service, and when. Checks
  /// run only while this is the current owner (ADR 0013).
  automatedChecksConsentById  String?            @db.Uuid
  automatedChecksConsentAt    DateTime?          @db.Timestamptz(3)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @db.Timestamptz(3)

  owner                  User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  automatedChecksConsent User?                 @relation("AutomatedChecksConsent", fields: [automatedChecksConsentById], references: [id], onDelete: Restrict)
  statusEvents           AssetStatusEvent[]
  ownerships             Ownership[]
  transferRequests       TransferRequest[]
  evidence               Evidence[]
  evidenceUploads        EvidenceUpload[]
  captureSessions        CaptureSession[]
  evidenceCommitments    EvidenceCommitment[]
  verificationRequests   VerificationRequest[]
  attestations           Attestation[]
  disputes               Dispute[]
  trustScoreSnapshots    TrustScoreSnapshot[]
  provenanceEvents       ProvenanceEvent[]
  automatedChecks        AutomatedCheck[]

  @@index([ownerId])
  @@index([serialFingerprint])
  @@index([category, status])
  @@map("assets")
}

/// Append-only.
model AssetStatusEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  assetId    String       @db.Uuid
  fromStatus AssetStatus?
  toStatus   AssetStatus
  reason     String?
  actorId    String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt])
  @@map("asset_status_events")
}

/// Custody periods. At most one open period (endedAt = null) per asset.
model Ownership {
  id                String          @id @default(uuid(7)) @db.Uuid
  assetId           String          @db.Uuid
  ownerId           String          @db.Uuid
  reason            OwnershipReason
  transferRequestId String?         @unique @db.Uuid
  startedAt         DateTime        @default(now()) @db.Timestamptz(3)
  endedAt           DateTime?       @db.Timestamptz(3)

  asset           Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  transferRequest TransferRequest? @relation(fields: [transferRequestId], references: [id], onDelete: Restrict)

  @@index([assetId, startedAt])
  @@map("ownerships")
}

/// Controlled transfer (ADR 0002). At most one PENDING or ACCEPTED transfer per asset.
model TransferRequest {
  id              String         @id @default(uuid(7)) @db.Uuid
  assetId         String         @db.Uuid
  fromUserId      String         @db.Uuid
  toUserId        String?        @db.Uuid
  toWalletAddress String
  status          TransferStatus @default(PENDING)
  /// The asset's status when the transfer started; restored when it ends without a transfer,
  /// and the status after it completes.
  statusBefore    AssetStatus?
  /// Why the transfer ended without completing, e.g. `rejected`, `asset_reported_stolen`.
  closedReason    String?
  /// Unsigned `transfer_asset` transaction (base64 wire bytes) with a durable nonce, prepared
  /// when the recipient accepts. Seller and buyer sign it; the oracle signs last and sends it.
  transaction     String?
  nonceAccount    String?
  /// Status sequence number the transaction records on-chain.
  statusSeq       Int?
  sellerSignature String?
  buyerSignature  String?
  expiresAt       DateTime       @db.Timestamptz(3)
  acceptedAt      DateTime?      @db.Timestamptz(3)
  completedAt     DateTime?      @db.Timestamptz(3)
  cancelledAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromUser  User       @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User?      @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)
  ownership Ownership?

  @@index([assetId, status])
  @@map("transfer_requests")
}

// ─── Evidence ─────────────────────────────────────────────────────────────────

model Evidence {
  id                    String             @id @default(uuid(7)) @db.Uuid
  assetId               String             @db.Uuid
  uploaderId            String             @db.Uuid
  type                  EvidenceType
  source                ProofSource        @default(OWNER)
  /// Private object-storage key. Never a public URL.
  storageKey            String             @unique
  /// Storage key of the metadata-free public copy; set only while the photo is public.
  publicStorageKey      String?            @unique
  /// Earliest evidence with the same file on another asset; flagged for admin review.
  duplicateOfId         String?            @db.Uuid
  /// 64-bit difference hash of an image, to find near-identical photos (ADR 0013); null for
  /// other files and for images too plain to fingerprint.
  perceptualHash        BigInt?
  sha256                String
  mimeType              String
  sizeBytes             Int
  visibility            EvidenceVisibility @default(PRIVATE)
  reviewStatus          ReviewStatus       @default(PENDING)
  reviewedById          String?            @db.Uuid
  reviewedAt            DateTime?          @db.Timestamptz(3)
  /// Shown to the owner; required when the evidence is rejected.
  reviewReason          String?
  /// Set on evidence added by the verifier assigned to this request (source VERIFIER).
  verificationRequestId String?            @db.Uuid
  /// Set on photos taken in a capture session (ADR 0013), with the shot they are.
  captureSessionId      String?            @db.Uuid
  captureShot           String?
  originalFilename      String?
  description           String?
  capturedAt            DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  asset               Asset                    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  verificationRequest VerificationRequest?     @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  captureSession      CaptureSession?          @relation(fields: [captureSessionId], references: [id], onDelete: Restrict)
  duplicateOf         Evidence?                @relation("EvidenceDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates          Evidence[]               @relation("EvidenceDuplicate")
  upload              EvidenceUpload?
  uploader            User                     @relation("EvidenceUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  reviewedBy          User?                    @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  commitmentItems     EvidenceCommitmentItem[]
  attestations        AttestationEvidence[]
  disputes            Dispute[]
  automatedChecks     AutomatedCheck[]

  @@unique([assetId, sha256])
  @@unique([captureSessionId, captureShot])
  @@index([sha256])
  @@map("evidence")
}

enum EvidenceUploadStatus {
  PENDING
  COMPLETED
  FAILED
}

/// A requested upload. Evidence is created only after the server has checked the stored file.
model EvidenceUpload {
  id                    String               @id @default(uuid(7)) @db.Uuid
  assetId               String               @db.Uuid
  uploaderId            String               @db.Uuid
  type                  EvidenceType
  /// Declared by the client; checked against the stored file.
  mimeType              String
  sizeBytes             Int
  sha256                String
  visibility            EvidenceVisibility
  originalFilename      String?
  description           String?
  capturedAt            DateTime?            @db.Timestamptz(3)
  /// Set when the verifier assigned to this request uploads.
  verificationRequestId String?              @db.Uuid
  /// Set when the upload is a shot of a capture session.
  captureSessionId      String?              @db.Uuid
  captureShot           String?
  /// Holding-area key the client uploads to. Never a public URL.
  stagingKey            String               @unique
  status                EvidenceUploadStatus @default(PENDING)
  failureReason         String?
  evidenceId            String?              @unique @db.Uuid
  expiresAt             DateTime             @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  completedAt           DateTime?            @db.Timestamptz(3)

  asset               Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  uploader            User                 @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  evidence            Evidence?            @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  captureSession      CaptureSession?      @relation(fields: [captureSessionId], references: [id], onDelete: Restrict)

  @@index([assetId, status])
  @@index([uploaderId, createdAt])
  @@map("evidence_uploads")
}

enum CaptureSessionStatus {
  OPEN
  COMPLETED
  /// Not every required shot arrived while the code was valid.
  EXPIRED
}

/// A timed photo session (ADR 0013): the owner photographs the required shots with the app's
/// camera, one of them next to the one-time code written on paper, while the code is valid.
model CaptureSession {
  id          String               @id @default(uuid(7)) @db.Uuid
  assetId     String               @db.Uuid
  ownerId     String               @db.Uuid
  code        String
  /// Shots required for the asset's category when the session started (CAPTURE_SHOTS).
  shots       String[]
  status      CaptureSessionStatus @default(OPEN)
  expiresAt   DateTime             @db.Timestamptz(3)
  completedAt DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  asset    Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  evidence Evidence[]
  uploads  EvidenceUpload[]

  @@index([assetId, createdAt])
  @@index([ownerId, createdAt])
  @@map("capture_sessions")
}

/// Append-only. Merkle root over a batch of evidence hashes, anchored on-chain.
model EvidenceCommitment {
  id            String   @id @default(uuid(7)) @db.Uuid
  assetId       String   @db.Uuid
  merkleRoot    String
  algorithm     String   @default("sha256-merkle-v1")
  evidenceCount Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  asset Asset                    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  items EvidenceCommitmentItem[]

  @@index([assetId, createdAt])
  @@map("evidence_commitments")
}

/// Append-only.
model EvidenceCommitmentItem {
  commitmentId String @db.Uuid
  leafIndex    Int
  evidenceId   String @db.Uuid
  sha256       String

  commitment EvidenceCommitment @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  evidence   Evidence           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([commitmentId, leafIndex])
  @@unique([commitmentId, evidenceId])
  @@map("evidence_commitment_items")
}

// ─── Verification ─────────────────────────────────────────────────────────────

model Verifier {
  id                      String             @id @default(uuid(7)) @db.Uuid
  userId                  String             @unique @db.Uuid
  status                  VerifierStatus     @default(APPLIED)
  entityType              VerifierEntityType
  businessName            String?
  website                 String?
  bio                     String?
  credentialStatus        ReviewStatus       @default(PENDING)
  attestationCount        Int                @default(0)
  disputeCount            Int                @default(0)
  upheldDisputeCount      Int                @default(0)
  revokedAttestationCount Int                @default(0)
  approvedById            String?            @db.Uuid
  approvedAt              DateTime?          @db.Timestamptz(3)
  chainVerifierAddress    String?            @unique
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(3)

  user                User                             @relation("VerifierUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy          User?                            @relation("VerifierApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  categoryPermissions VerifierCategoryPermission[]
  statusEvents        VerifierStatusEvent[]
  applicationReports  VerifierApplicationReport[]
  assignedRequests    VerificationRequest[]
  requestStatusEvents VerificationRequestStatusEvent[]
  attestations        Attestation[]

  @@index([status])
  @@map("verifiers")
}

/// A watch specialist does not automatically have permission to authenticate fine art.
/// At most one permission per verifier and category that is not REVOKED; revoked rows stay as history.
model VerifierCategoryPermission {
  id           String                   @id @default(uuid(7)) @db.Uuid
  verifierId   String                   @db.Uuid
  category     AssetCategory
  status       CategoryPermissionStatus @default(PENDING)
  approvedById String?                  @db.Uuid
  approvedAt   DateTime?                @db.Timestamptz(3)
  revokedAt    DateTime?                @db.Timestamptz(3)
  reason       String?
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)

  verifier   Verifier                          @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  approvedBy User?                             @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  events     VerifierCategoryPermissionEvent[]

  @@index([verifierId, category])
  @@map("verifier_category_permissions")
}

/// Append-only.
model VerifierCategoryPermissionEvent {
  id           String                    @id @default(uuid(7)) @db.Uuid
  permissionId String                    @db.Uuid
  fromStatus   CategoryPermissionStatus?
  toStatus     CategoryPermissionStatus
  reason       String?
  actorId      String?                   @db.Uuid
  createdAt    DateTime                  @default(now()) @db.Timestamptz(3)

  permission VerifierCategoryPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  actor      User?                      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([permissionId, createdAt])
  @@map("verifier_category_permission_events")
}

/// Append-only.
model VerifierStatusEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  verifierId String          @db.Uuid
  fromStatus VerifierStatus?
  toStatus   VerifierStatus
  reason     String?
  actorId    String?         @db.Uuid
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  verifier Verifier @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([verifierId, createdAt])
  @@map("verifier_status_events")
}

/// Code and category never change.
model VerificationTemplate {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  category    AssetCategory
  name        String
  description String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  versions VerificationTemplateVersion[]

  @@index([category])
  @@map("verification_templates")
}

/// Immutable once PUBLISHED (only PUBLISHED -> RETIRED is allowed). At most one PUBLISHED version
/// per template; it is published by an admin other than its creator, unless the creator is the
/// only active admin.
model VerificationTemplateVersion {
  id               String                @id @default(uuid(7)) @db.Uuid
  templateId       String                @db.Uuid
  version          Int
  status           TemplateVersionStatus @default(DRAFT)
  requiredClaims   Json
  requiredEvidence Json
  allowedMethods   Json
  minVerifiers     Int                   @default(1)
  createdById      String?               @db.Uuid
  publishedById    String?               @db.Uuid
  /// Attestations under this version are valid for at most this many months.
  validityMonths   Int                   @default(60)
  publishedAt      DateTime?             @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)

  template     VerificationTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("TemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy  User?                 @relation("TemplateVersionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  requests     VerificationRequest[]
  attestations Attestation[]

  @@unique([templateId, version])
  @@map("verification_template_versions")
}

/// Opened by the asset owner, claimed by one verifier. At most one OPEN or ASSIGNED request per
/// asset and template version. Every status change is recorded in VerificationRequestStatusEvent.
model VerificationRequest {
  id                 String                    @id @default(uuid(7)) @db.Uuid
  assetId            String                    @db.Uuid
  requesterId        String                    @db.Uuid
  templateVersionId  String                    @db.Uuid
  assignedVerifierId String?                   @db.Uuid
  status             VerificationRequestStatus @default(OPEN)
  assignedAt         DateTime?                 @db.Timestamptz(3)
  completedAt        DateTime?                 @db.Timestamptz(3)
  expiresAt          DateTime                  @db.Timestamptz(3)
  /// Why the request was cancelled or expired.
  closedReason       String?
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)

  asset            Asset                            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  requester        User                             @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  templateVersion  VerificationTemplateVersion      @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignedVerifier Verifier?                        @relation(fields: [assignedVerifierId], references: [id], onDelete: Restrict)
  attestations     Attestation[]
  evidence         Evidence[]
  evidenceUploads  EvidenceUpload[]
  statusEvents     VerificationRequestStatusEvent[]

  @@index([assetId, status])
  @@index([status, createdAt])
  @@index([assignedVerifierId, status])
  @@map("verification_requests")
}

/// Append-only. `verifierId` is the assigned verifier after the change.
model VerificationRequestStatusEvent {
  id         String                     @id @default(uuid(7)) @db.Uuid
  requestId  String                     @db.Uuid
  fromStatus VerificationRequestStatus?
  toStatus   VerificationRequestStatus
  verifierId String?                    @db.Uuid
  reason     String?
  actorId    String?                    @db.Uuid
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)

  request  VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  verifier Verifier?           @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  actor    User?               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("verification_request_status_events")
}

/// Signed claim by the verifier assigned to a verification request. Claim, signature and payload
/// fields are immutable; only status may change, and every change is recorded in
/// AttestationStatusEvent. At most one ACTIVE or DISPUTED attestation per verifier, asset and claim.
model Attestation {
  id                      String            @id @default(uuid(7)) @db.Uuid
  assetId                 String            @db.Uuid
  verifierId              String            @db.Uuid
  verificationRequestId   String            @db.Uuid
  templateVersionId       String            @db.Uuid
  claimType               ClaimType
  result                  AttestationResult
  method                  AttestationMethod
  assuranceLevel          AssuranceLevel
  /// Assessed condition. Only on CONDITION claims; required when the claim is CONFIRMED.
  conditionGrade          ItemCondition?
  notes                   String?
  nonce                   String
  /// The exact text the verifier's wallet signed (wb-attestation-v1). Private: names the wallet.
  signedMessage           String
  /// SHA-256 of signedMessage.
  signedPayloadHash       String
  /// Base58 Ed25519 signature by the verifier's wallet over signedMessage.
  signature               String
  issuedAt                DateTime          @db.Timestamptz(3)
  expiresAt               DateTime?         @db.Timestamptz(3)
  status                  AttestationStatus @default(ACTIVE)
  supersedesId            String?           @unique @db.Uuid
  chainAttestationAddress String?           @unique
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)

  asset               Asset                       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  verifier            Verifier                    @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  verificationRequest VerificationRequest         @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  templateVersion     VerificationTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  supersedes          Attestation?                @relation("Supersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        Attestation?                @relation("Supersession")
  evidence            AttestationEvidence[]
  statusEvents        AttestationStatusEvent[]
  disputes            Dispute[]

  @@unique([verifierId, nonce])
  @@index([assetId, status])
  @@map("attestations")
}

/// Append-only.
model AttestationEvidence {
  attestationId String @db.Uuid
  evidenceId    String @db.Uuid
  /// Evidence hash at signing time.
  sha256        String

  attestation Attestation @relation(fields: [attestationId], references: [id], onDelete: Restrict)
  evidence    Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([attestationId, evidenceId])
  @@map("attestation_evidence")
}

/// Append-only.
model AttestationStatusEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  attestationId String             @db.Uuid
  fromStatus    AttestationStatus?
  toStatus      AttestationStatus
  reason        String?
  actorId       String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  attestation Attestation @relation(fields: [attestationId], references: [id], onDelete: Restrict)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([attestationId, createdAt])
  @@map("attestation_status_events")
}

model Dispute {
  id            String        @id @default(uuid(7)) @db.Uuid
  assetId       String        @db.Uuid
  attestationId String?       @db.Uuid
  evidenceId    String?       @db.Uuid
  openedById    String        @db.Uuid
  reason        String
  details       String?
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedById  String?       @db.Uuid
  resolvedAt    DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  attestation Attestation? @relation(fields: [attestationId], references: [id], onDelete: Restrict)
  evidence    Evidence?    @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  openedBy    User         @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy  User?        @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([assetId, status])
  @@map("disputes")
}

// ─── Trust ────────────────────────────────────────────────────────────────────

/// Append-only. Output of @worthybound/trust-engine, reproducible from inputsHash.
model TrustScoreSnapshot {
  id                String            @id @default(uuid(7)) @db.Uuid
  assetId           String            @db.Uuid
  score             Int
  verificationLevel VerificationLevel
  factors           Json
  deductions        Json
  capsApplied       Json
  excludedProofs    Json
  engineVersion     String
  weightsVersion    String
  inputsHash        String
  computedAt        DateTime          @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, computedAt])
  @@map("trust_score_snapshots")
}

// ─── Automated checks (ADR 0013) ────────────────────────────────────────

/// Append-only. One check of one evidence file. The newest check of a file supersedes older ones.
model AutomatedCheck {
  id                 String               @id @default(uuid(7)) @db.Uuid
  assetId            String               @db.Uuid
  evidenceId         String               @db.Uuid
  result             AutomatedCheckResult
  /// Problem categories (CHECK_PROBLEMS); the only findings owners see.
  problems           String[]
  /// Detection details, for administrators only.
  summary            String
  /// The model's confidence (0-1); null for deterministic checks.
  confidence         Float?
  /// e.g. `openai`, or `worthybound` for deterministic checks.
  engine             String
  /// Model (as reported by the service) or deterministic rule that produced the result.
  model              String
  checkVersion       String
  /// SHA-256 of the file that was examined.
  sha256             String
  /// SHA-256 of the document's normalized number, to find the same document on other assets.
  documentNumberHash String?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([evidenceId, createdAt])
  @@index([documentNumberHash])
  @@map("automated_checks")
}

/// Append-only. Advisory AI report on a verifier application; reviewers make every decision.
/// Never shown to the applicant.
model VerifierApplicationReport {
  id             String                       @id @default(uuid(7)) @db.Uuid
  verifierId     String                       @db.Uuid
  recommendation VerifierReportRecommendation
  summary        String
  strengths      String[]
  concerns       String[]
  /// Questions the reviewer could ask the applicant.
  questions      String[]
  /// Web pages the model consulted.
  sources        String[]
  /// SHA-256 of the canonical application data the report was made from.
  inputHash      String
  engine         String
  model          String
  reportVersion  String
  /// Reviewer who asked for a new report; null for the report made on application.
  requestedById  String?                      @db.Uuid
  createdAt      DateTime                     @default(now()) @db.Timestamptz(3)

  verifier    Verifier @relation(fields: [verifierId], references: [id], onDelete: Restrict)
  requestedBy User?    @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([verifierId, createdAt])
  @@map("verifier_application_reports")
}

/// Queued checks and reports. At most one PENDING job per kind and entity.
model AutomatedJob {
  id            String             @id @default(uuid(7)) @db.Uuid
  kind          AutomatedJobKind
  /// Evidence (EVIDENCE_CHECK) or verifier (VERIFIER_REPORT).
  entityId      String             @db.Uuid
  status        AutomatedJobStatus @default(PENDING)
  attempts      Int                @default(0)
  runAfter      DateTime           @default(now()) @db.Timestamptz(3)
  lastError     String?
  requestedById String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([status, runAfter])
  @@index([kind, entityId])
  @@map("automated_jobs")
}

// ─── History, chain and audit ─────────────────────────────────────────────────

/// Append-only, hash-chained per asset. sequence, prevHash and hash are set by the database.
model ProvenanceEvent {
  id         String              @id @default(uuid(7)) @db.Uuid
  assetId    String              @db.Uuid
  sequence   Int                 @default(0)
  type       ProvenanceEventType
  actorId    String?             @db.Uuid
  payload    Json                @default("{}")
  occurredAt DateTime            @default(now()) @db.Timestamptz(3)
  prevHash   String?
  hash       String              @unique @default("")
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([assetId, sequence])
  @@map("provenance_events")
}

/// Every chain action is idempotent through idempotencyKey.
model ChainTransaction {
  id             String                 @id @default(uuid(7)) @db.Uuid
  idempotencyKey String                 @unique
  kind           ChainTransactionKind
  cluster        SolanaCluster          @default(DEVNET)
  entityType     ChainEntityType
  entityId       String                 @db.Uuid
  status         ChainTransactionStatus @default(PENDING)
  signature      String?                @unique
  slot           BigInt?
  attempts       Int                    @default(0)
  lastError      String?
  submittedAt    DateTime?              @db.Timestamptz(3)
  confirmedAt    DateTime?              @db.Timestamptz(3)
  finalizedAt    DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([status])
  @@map("chain_transactions")
}

/// Append-only.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  targetType    String
  targetId      String?
  metadata      Json     @default("{}")
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Replays of a create request with the same Idempotency-Key return the original result.
model IdempotencyKey {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  /// Operation the key belongs to, e.g. asset.register.
  scope       String
  key         String
  /// SHA-256 of the canonical request body; a reused key with a different body is rejected.
  requestHash String
  resourceId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, scope, key])
  @@map("idempotency_keys")
}
