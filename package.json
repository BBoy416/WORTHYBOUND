{
  "name": "worthybound",
  "version": "0.0.0",
  "private": true,
  "description": "WorthyBound: digital identity, evidence and trust layer for physical assets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "gitleaks git --redact --verbose",
    "db:generate": "pnpm --filter @worthybound/database generate",
    "db:migrate:dev": "pnpm --filter @worthybound/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @worthybound/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @worthybound/database db:migrate:status",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
